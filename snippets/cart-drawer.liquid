<aside class="cart-drawer" id="CartDrawer" aria-hidden="true" data-cart-drawer>
  <div class="cart-drawer__overlay" data-cart-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Shopping cart">
    <header class="cart-drawer__header">
      <div>
        <p class="eyebrow">Your cart</p>
        <h2>Living pieces</h2>
      </div>
      <button class="icon-button" type="button" data-cart-close aria-label="Close cart">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </header>
    <div class="cart-drawer__items" data-cart-items>
      {% if cart.item_count == 0 %}
        <p class="cart-drawer__empty">Your cart is ready for the first full stop.</p>
      {% else %}
        {% for item in cart.items %}
          <div class="cart-item" data-line="{{ forloop.index }}">
            <a href="{{ item.url }}" class="cart-item__image">
              {% if item.image %}
                {{ item.image | image_url: width: 180 | image_tag: widths: '90,140,180', alt: item.product.title, loading: 'lazy' }}
              {% else %}
                <img src="{{ 'logo-mark.png' | asset_url }}" alt="{{ item.product.title | escape }}" loading="lazy">
              {% endif %}
            </a>
            <div class="cart-item__content">
              <a href="{{ item.url }}">{{ item.product.title }}</a>
              <span>{{ item.variant.title }}</span>
              <div class="cart-item__controls">
                <button type="button" data-cart-qty="-1" aria-label="Decrease quantity">-</button>
                <span>{{ item.quantity }}</span>
                <button type="button" data-cart-qty="1" aria-label="Increase quantity">+</button>
                <button type="button" data-cart-remove>Remove</button>
              </div>
            </div>
            <strong>{{ item.final_line_price | money }}</strong>
          </div>
        {% endfor %}
      {% endif %}
    </div>
    <footer class="cart-drawer__footer">
      <p class="cart-drawer__status" data-cart-status role="status" aria-live="polite"></p>
      <p>A full stop on fast fashion. A step toward Living Kits.</p>
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <strong>{{ cart.total_price | money }}</strong>
      </div>
      <small>Shipping and taxes calculated at checkout.</small>
      {% render 'checkout-reassurance' %}
      <a class="tls-button tls-button--primary" href="/checkout">Checkout</a>
    </footer>
  </div>
</aside>
