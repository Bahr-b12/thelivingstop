{% if settings.enable_full_stop_animation %}
  <div class="impact-quote" data-impact-quote data-impact-quote-primary="{{ settings.impact_quote | default: 'Every piece helps fund food, shelter, and care.' | escape }}">
    <span class="impact-quote__dot" aria-hidden="true"></span>
    <span class="impact-quote__text" data-impact-quote-text aria-hidden="true"></span><span class="impact-quote__caret" aria-hidden="true"></span>
    <span class="visually-hidden">Every piece helps fund food, shelter, and care.</span>
  </div>
{% endif %}
