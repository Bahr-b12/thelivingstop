<main class="launch-shell" data-launch-page data-launch-date="{{ section.settings.launch_date | default: '2026-08-15T00:00:00+03:00' }}">
  <div class="launch-visuals" aria-hidden="true">
    <div class="launch-visual launch-visual--one"><video autoplay muted loop playsinline preload="metadata"><source src="{{ 'launch-01.mp4' | asset_url }}" type="video/mp4"></video></div>
    <div class="launch-visual launch-visual--two"><video autoplay muted loop playsinline preload="metadata"><source src="{{ 'launch-02.mp4' | asset_url }}" type="video/mp4"></video></div>
    <div class="launch-visual launch-visual--three"><video autoplay muted loop playsinline preload="metadata"><source src="{{ 'launch-03.mp4' | asset_url }}" type="video/mp4"></video></div>
    <div class="launch-visual launch-visual--four"><video autoplay muted loop playsinline preload="metadata"><source src="{{ 'launch-04.mp4' | asset_url }}" type="video/mp4"></video></div>
  </div>
  <div class="launch-overlay"></div>
  <div class="launch-content">
    <header class="launch-header">
      <a class="launch-logo" href="{{ routes.root_url }}" aria-label="THELIVINGSTOP home">
        <img src="{{ 'logo-white.png' | asset_url }}" alt="THELIVINGSTOP" width="190" height="54">
      </a>
      <span class="launch-status"><i aria-hidden="true"></i> Launching soon</span>
    </header>
    <section class="launch-hero" aria-labelledby="LaunchTitle">
      <p class="launch-kicker">THELIVINGSTOP / LAUNCH</p>
      <h1 id="LaunchTitle">The wait ends <em>{{ section.settings.display_date | default: '15 AUG' }}</em></h1>
      <p class="launch-hero__copy">New pieces. Same values.</p>
      <div class="launch-countdown" data-launch-countdown aria-label="Countdown to launch">
        <div><strong data-unit="days">00</strong><span>Days</span></div>
        <div><strong data-unit="hours">00</strong><span>Hours</span></div>
        <div><strong data-unit="minutes">00</strong><span>Minutes</span></div>
        <div><strong data-unit="seconds">00</strong><span>Seconds</span></div>
      </div>
    </section>
    <section class="launch-signup" id="LaunchSignup" aria-labelledby="LaunchSignupTitle">
      <div class="launch-signup__intro">
        <p class="launch-kicker">First access</p>
        <h2 id="LaunchSignupTitle">Get the first drop.</h2>
        <p>Join for launch access and 10% off.</p>
      </div>
      {% form 'contact', class: 'launch-form' %}
        {% if form.posted_successfully? %}
          <div class="launch-success" role="status"><strong>You're in.</strong><span>Your launch welcome is reserved.</span></div>
        {% endif %}
        {{ form.errors | default_errors }}
        <input type="hidden" name="contact[request_type]" value="Launch countdown signup">
        <div class="launch-form__row">
          <label><span class="visually-hidden">First name</span><input type="text" name="contact[first_name]" placeholder="First name" autocomplete="given-name" required></label>
          <label><span class="visually-hidden">Last name</span><input type="text" name="contact[last_name]" placeholder="Last name" autocomplete="family-name"></label>
        </div>
        <label><span class="visually-hidden">Email address</span><input type="email" name="contact[email]" placeholder="Email address" autocomplete="email" required></label>
        <label><span class="visually-hidden">Phone number</span><input type="tel" name="contact[phone]" placeholder="Phone number" autocomplete="tel"></label>
        <label class="launch-form__consent"><input type="checkbox" name="contact[marketing_consent]" value="Yes" required><span>Send me launch updates and my 10% welcome.</span></label>
        <button type="submit">Join the launch list</button>
        <small>Unsubscribe any time.</small>
      {% endform %}
    </section>
    <footer class="launch-footer"><span>Premium pieces. Ethical DNA.</span><span>Launch / {{ section.settings.display_date | default: '15 AUG' }}</span></footer>
  </div>
</main>
{% schema %}
{"name":"Launch countdown","settings":[{"type":"text","id":"launch_date","label":"Launch date and time","default":"2026-08-15T00:00:00+03:00","info":"Use ISO format with timezone, for example 2026-08-15T00:00:00+03:00."},{"type":"text","id":"display_date","label":"Launch date label","default":"15 AUG"}],"presets":[{"name":"Launch countdown"}]}
{% endschema %}
