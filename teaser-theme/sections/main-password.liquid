<main class="teaser-shell">
  <div class="teaser-shell__image" aria-hidden="true">
    <img src="{{ 'teaser-product.jpg' | asset_url }}" alt="" loading="eager">
  </div>
  <div class="teaser-shell__content">
    <header class="teaser-header">
      <a href="{{ routes.root_url }}" class="teaser-logo" aria-label="THELIVINGSTOP home">
        <img src="{{ 'logo-dark.png' | asset_url }}" alt="THELIVINGSTOP" width="180" height="51">
      </a>
      <span class="teaser-header__status"><i></i> Arriving soon</span>
    </header>

    <section class="teaser-hero">
      <p class="teaser-kicker">Life. Period.</p>
      <h1>Made for the life you choose.</h1>
      <p class="teaser-hero__copy">Premium streetwear with a serious conscience. The first THELIVINGSTOP drop is almost here.</p>
      <div class="teaser-offer"><span>10%</span><div><strong>Launch welcome</strong><small>Your early-access code arrives when you join.</small></div></div>
    </section>

    <section class="teaser-signup" id="TeaserSignup" aria-labelledby="TeaserSignupTitle">
      <div>
        <p class="teaser-kicker">First in line</p>
        <h2 id="TeaserSignupTitle">Enter the living list.</h2>
        <p>Join for first access, fit notes, material stories, and your 10% launch welcome.</p>
      </div>
      {% form 'contact', class: 'teaser-form' %}
        {% if form.posted_successfully? %}
          <div class="teaser-success" role="status"><strong>You're in.</strong><span>Your 10% launch welcome is reserved. Watch your inbox.</span><a href="/discount/LIVING10">Save the welcome code</a></div>
        {% endif %}
        {{ form.errors | default_errors }}
        <input type="hidden" name="contact[request_type]" value="Pre-launch early access signup">
        <div class="teaser-form__row"><label><span class="visually-hidden">First name</span><input type="text" name="contact[first_name]" placeholder="First name" autocomplete="given-name" required></label><label><span class="visually-hidden">Last name</span><input type="text" name="contact[last_name]" placeholder="Last name" autocomplete="family-name"></label></div>
        <label><span class="visually-hidden">Email address</span><input type="email" name="contact[email]" placeholder="Email address" autocomplete="email" required></label>
        <label><span class="visually-hidden">Phone number</span><input type="tel" name="contact[phone]" placeholder="Phone number" autocomplete="tel"></label>
        <label class="teaser-form__consent"><input type="checkbox" name="contact[marketing_consent]" value="Yes" required><span>Send me launch updates and my 10% early-access welcome.</span></label>
        <button type="submit">Reserve my 10%</button>
        <small>By joining, you agree to receive THELIVINGSTOP launch updates. Unsubscribe any time.</small>
      {% endform %}
    </section>

    <footer class="teaser-footer"><span>Premium pieces. Ethical DNA.</span><a href="/password">Store access</a><span>&copy; {{ 'now' | date: '%Y' }} THELIVINGSTOP</span></footer>
  </div>
  <img class="teaser-motion" src="{{ 'full-stop-motion.svg' | asset_url }}" alt="" aria-hidden="true">
</main>
{% schema %}
{"name":"Pre-launch teaser","settings":[]}
{% endschema %}
