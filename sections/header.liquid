<header class="site-header" data-header>
  <div class="site-header__inner">
    <button class="icon-button site-header__menu" type="button" data-menu-open aria-label="Open menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
    {% render 'logo', tone: 'dark' %}
    <nav class="site-nav" aria-label="Primary navigation">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% else %}
        <a href="/collections/new-in">New In</a><a href="/pages/products">Products</a><a href="/collections/t-shirts">T-Shirts</a><a href="/collections/hoodies">Hoodies</a><a href="/collections/denim">Denim</a><a href="/collections/matching-fits">Matching Fits</a><a href="/pages/mission">Mission</a><a href="/pages/about">About</a><a href="/pages/contact">Contact</a>
      {% endfor %}
    </nav>
    <div class="site-header__actions">
      <a class="icon-button" href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m16.5 16.5 3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </a>
      <a class="icon-button" href="{{ routes.account_url }}" aria-label="Account">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </a>
      <a class="icon-button site-header__wishlist" href="/pages/wishlist" aria-label="Wishlist">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.3 5.7a5 5 0 0 0-7.1 0L12 6.9l-1.2-1.2a5 5 0 1 0-7.1 7.1L12 21l8.3-8.2a5 5 0 0 0 0-7.1Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      </a>
      <button class="icon-button cart-trigger" type="button" data-cart-open aria-label="Open cart">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h15l-2 9H8L6 3H3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
        <span data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="MobileMenu" aria-hidden="true">
    <div class="mobile-menu__overlay" data-menu-close></div>
    <nav class="mobile-menu__panel" aria-label="Mobile navigation">
      <button class="icon-button" type="button" data-menu-close aria-label="Close menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% else %}
        <a href="/collections/new-in">New In</a><a href="/pages/products">Products</a><a href="/collections/t-shirts">T-Shirts</a><a href="/collections/hoodies">Hoodies</a><a href="/collections/denim">Denim</a><a href="/collections/matching-fits">Matching Fits</a><a href="/pages/mission">Mission</a><a href="/pages/about">About</a><a href="/pages/contact">Contact</a>
      {% endfor %}
    </nav>
  </div>
</header>
{% schema %}
{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Primary menu","default":"main-menu"}]}
{% endschema %}
