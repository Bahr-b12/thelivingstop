<section class="trend-shortcuts section-pad">
  <div class="section-heading">
    <p class="eyebrow">Trending now</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="trend-shortcuts__grid">
    {% for block in section.blocks %}
      <a class="trend-tile" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 720 | image_tag: widths: '320,520,720', sizes: '(min-width: 900px) 20vw, 50vw', loading: 'lazy', alt: block.settings.title }}
        {% else %}
          <img src="{{ block.settings.asset_name | default: 'black-tee-male-1.jpg' | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {% endif %}
        <span>{{ block.settings.title }}</span>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Trending shortcuts","settings":[{"type":"text","id":"heading","label":"Heading","default":"Fast paths to living pieces."}],"blocks":[{"type":"shortcut","name":"Shortcut","settings":[{"type":"text","id":"title","label":"Title","default":"New In"},{"type":"url","id":"link","label":"Link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"asset_name","label":"Fallback asset filename","default":"black-tee-male-1.jpg"}]}],"presets":[{"name":"Trending shortcuts","blocks":[{"type":"shortcut","settings":{"title":"New In","asset_name":"matching-outfits-1.jpg"}},{"type":"shortcut","settings":{"title":"T-Shirts","asset_name":"white-tee-male-1.jpg"}},{"type":"shortcut","settings":{"title":"Polos","asset_name":"black-polo-1.jpg"}},{"type":"shortcut","settings":{"title":"Matching Fits","asset_name":"matching-outfits-2.jpg"}}]}]}
{% endschema %}
