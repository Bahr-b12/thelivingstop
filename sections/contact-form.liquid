<section class="contact-page section-pad">
  <div><p class="eyebrow">Contact</p><h1>Talk to THELIVINGSTOP.</h1><p>Customer care, collaborations, sizing, and mission questions. Keep it direct.</p></div>
  {% form 'contact', class: 'contact-form' %}
    {% if form.posted_successfully? %}<p class="form-success">Message sent. We will get back to you soon.</p>{% endif %}
    {{ form.errors | default_errors }}
    <label>Name<input type="text" name="contact[name]" autocomplete="name"></label>
    <label>Email<input type="email" name="contact[email]" autocomplete="email" required></label>
    <label>Message<textarea name="contact[body]" rows="6" required></textarea></label>
    <button class="tls-button tls-button--primary" type="submit">Send message</button>
  {% endform %}
</section>
{% schema %}
{"name":"Contact form"}
{% endschema %}
