<section class="community-grid section-pad">
  <div class="section-heading"><p class="eyebrow">Looks best on you</p><h2>Tag @thelivingstop. You might make the grid.</h2></div>
  <div class="community-grid__images">
    {% assign assets = 'gray-tee-female-1.jpg,blue-tee-male-1.jpg,matching-outfits-2.jpg,white-tee-female-1.jpg,black-polo-1.jpg,product-concrete-5.jpg' | split: ',' %}
    {% for asset in assets %}
      <img src="{{ asset | asset_url }}" alt="THELIVINGSTOP community look" loading="lazy">
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Community grid","presets":[{"name":"Community grid"}]}
{% endschema %}
