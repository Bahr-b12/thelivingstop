<section class="hero">
  <div class="hero__media">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1800x' }}
    {% elsif section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2200 | image_tag: widths: '750,1100,1500,2200', sizes: '100vw', loading: 'eager', alt: section.settings.heading }}
    {% else %}
      <video autoplay muted loop playsinline poster="{{ 'matching-outfits-1.jpg' | asset_url }}"><source src="{{ 'living-stop-reel-1.mp4' | asset_url }}" type="video/mp4"></video>
    {% endif %}
  </div>
  <div class="hero__content">
    <p class="eyebrow">Where fast fashion ends.</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    <div class="hero__actions">
      {% render 'button', label: section.settings.primary_label, href: section.settings.primary_link, style: 'primary' %}
      {% render 'button', label: section.settings.secondary_label, href: section.settings.secondary_link, style: 'light' %}
    </div>
  </div>
  {% render 'red-circle', class: 'hero__period' %}
</section>
{% schema %}
{"name":"Homepage hero","settings":[{"type":"text","id":"heading","label":"Heading","default":"THELIVINGSTOP"},{"type":"text","id":"subheading","label":"Subheading","default":"Life. Period."},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"primary_label","label":"Primary label","default":"Shop New In"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"secondary_label","label":"Secondary label","default":"Explore the Mission"},{"type":"image_picker","id":"image","label":"Fallback image"},{"type":"video","id":"video","label":"Hero video"}],"presets":[{"name":"Homepage hero"}]}
{% endschema %}
