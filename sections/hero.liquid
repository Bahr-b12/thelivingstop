<section class="hero">
  <div class="hero__media">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1800x' }}
    {% elsif section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2200 | image_tag: widths: '750,1100,1500,2200', sizes: '100vw', loading: 'eager', alt: section.settings.heading }}
    {% else %}
      <video autoplay muted loop playsinline poster="{{ 'matching-outfits-1.jpg' | asset_url }}"><source src="{{ 'living-stop-reel-1.mp4' | asset_url }}" type="video/mp4"></video>
    {% endif %}
  </div>
  <div class="hero__content">
    <p class="eyebrow">Against fast fashion.</p>
    <h1 class="hero__brand">
      {% if section.settings.hero_logo != blank %}
        {{ section.settings.hero_logo | image_url: width: 1400 | image_tag: widths: '480,720,1000,1400', sizes: '(min-width: 900px) 42vw, 78vw', class: 'hero__brand-image', alt: section.settings.heading, loading: 'eager' }}
      {% else %}
        <picture>
          <source media="(max-width: 680px)" srcset="{{ 'hero-logo-mobile.png' | asset_url }}">
          <img src="{{ 'hero-logo.png' | asset_url }}" class="hero__brand-image" width="1845" height="1150" alt="{{ section.settings.heading | escape }}" loading="eager">
        </picture>
      {% endif %}
    </h1>
    <p>{{ section.settings.subheading }}</p>
    <div class="hero__actions">
      {% render 'button', label: section.settings.primary_label, href: section.settings.primary_link, style: 'primary' %}
      {% render 'button', label: section.settings.secondary_label, href: section.settings.secondary_link, style: 'light' %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Homepage hero","settings":[{"type":"text","id":"heading","label":"Logo alt text","default":"THELIVINGSTOP"},{"type":"image_picker","id":"hero_logo","label":"Hero logo override"},{"type":"text","id":"subheading","label":"Subheading","default":"Life. Period."},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"primary_label","label":"Primary label","default":"Shop New In"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"secondary_label","label":"Secondary label","default":"Explore the Mission"},{"type":"image_picker","id":"image","label":"Fallback image"},{"type":"video","id":"video","label":"Hero video"}],"presets":[{"name":"Homepage hero"}]}
{% endschema %}
