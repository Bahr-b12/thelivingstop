<section class="mission-band section-pad">
  <div class="mission-band__mark">{% render 'red-circle' %}</div>
  <div class="mission-band__copy">
    <p class="eyebrow">Learn to Live All Together</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.copy }}</p>
  </div>
  <div class="mission-band__grid">
    <div><strong>Quality</strong><span>A full stop on landfill fashion through durable construction.</span></div>
    <div><strong>Ethics</strong><span>A strict anti-child-labor standard across production.</span></div>
    <div><strong>Living Kits</strong><span>Proceeds support food, shelter, education, and sanctuary resources.</span></div>
    <div><strong>Co-existence</strong><span>For children, animals, and communities learning to live together.</span></div>
  </div>
</section>
{% schema %}
{"name":"Mission band","settings":[{"type":"text","id":"heading","label":"Heading","default":"Not charity. A conscious way to live."},{"type":"textarea","id":"copy","label":"Copy","default":"THELIVINGSTOP is a fashion brand with a serious conscience. Every purchase helps fund Living Kits for orphan children and orphan animals while holding the line on quality and ethical production."}],"presets":[{"name":"Mission band"}]}
{% endschema %}
