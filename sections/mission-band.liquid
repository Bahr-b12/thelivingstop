<section class="mission-band section-pad">
  <div class="mission-band__mark">{% render 'red-circle' %}</div>
  <div class="mission-band__copy">
    <p class="eyebrow">Our mission</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.copy }}</p>
  </div>
  <div class="mission-band__grid">
    <div><strong>Quality</strong><span>Made to last.</span></div>
    <div><strong>Ethics</strong><span>No child labor.</span></div>
    <div><strong>Living Kits</strong><span>Food, shelter, and care.</span></div>
    <div><strong>Co-existence</strong><span>For people and animals.</span></div>
  </div>
</section>
{% schema %}
{"name":"Mission band","settings":[{"type":"text","id":"heading","label":"Heading","default":"Wear well. Give back."},{"type":"textarea","id":"copy","label":"Copy","default":"Every purchase helps fund Living Kits for children and animals."}],"presets":[{"name":"Mission band"}]}
{% endschema %}
