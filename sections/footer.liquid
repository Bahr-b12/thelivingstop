<footer class="site-footer">
  <div class="site-footer__top">
    {% render 'logo' %}
    <div class="newsletter">
      <p class="eyebrow">Join the list.</p>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail">Email</label>
        <input id="NewsletterEmail" type="email" name="contact[email]" placeholder="Email address" required>
        <button type="submit">Sign up</button>
      {% endform %}
    </div>
  </div>
  <div class="site-footer__columns">
    <nav><h2>Shop</h2><a href="/collections/new-in">New In</a><a href="/collections/t-shirts">T-Shirts</a><a href="/collections/polos">Polos</a></nav>
    <nav><h2>Mission</h2><a href="/pages/signup">Early Access</a><a href="/pages/mission">Living Kits</a><a href="/pages/about">About</a><a href="/pages/shipping">Shipping</a><a href="/pages/contact">Contact</a><a href="/policies/refund-policy">Returns</a></nav>
    <nav><h2>Social</h2><a href="https://www.instagram.com/thelivingstop">Instagram</a><a href="https://www.tiktok.com/@thelivingstop">TikTok</a><a href="https://www.facebook.com/people/Thelivingstop/61587138385183/">Facebook</a></nav>
    <div><h2>Life. Period.</h2><p>Made to move. Made with care.</p>{% render 'red-circle' %}</div>
  </div>
  <div class="site-footer__bottom"><span>&copy; {{ 'now' | date: '%Y' }} THELIVINGSTOP</span><a href="/policies/privacy-policy">Privacy</a><a href="/policies/terms-of-service">Terms</a></div>
</footer>
{% schema %}
{"name":"Footer"}
{% endschema %}
