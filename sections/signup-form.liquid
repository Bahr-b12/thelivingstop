<section class="signup-page section-pad">
  <div class="signup-page__intro">
    <p class="eyebrow">Early access / 10% off</p>
    <h1>Be first in.</h1>
    <p>Join the list for launch access and sizing help. Checkout collects delivery and payment details when you order.</p>
    <div class="signup-page__note"><strong>You receive</strong><span>Launch access and 10% off.</span></div>
  </div>
  <div class="signup-page__form-wrap">
    {% form 'contact', class: 'signup-form' %}
      {% if form.posted_successfully? %}
        <div class="form-success" role="status"><strong>You are on the list.</strong><span>We will send your 10% welcome.</span></div>
      {% endif %}
      {{ form.errors | default_errors }}
      <input type="hidden" name="contact[request_type]" value="Launch signup / early access">
      <label>First name<input type="text" name="contact[first_name]" autocomplete="given-name" required></label>
      <label>Last name<input type="text" name="contact[last_name]" autocomplete="family-name"></label>
      <label>Email<input type="email" name="contact[email]" autocomplete="email" required></label>
      <label>Phone<input type="tel" name="contact[phone]" autocomplete="tel" required></label>
      <div class="signup-form__grid">
        <label>Country / city<input type="text" name="contact[location]" autocomplete="country-name" required></label>
        <label>Preferred size
          <select name="contact[preferred_size]" required>
            <option value="" selected disabled>Select a size</option>
            <option>XS</option><option>S</option><option>M</option><option>L</option><option>XL</option><option>XXL</option><option>Not sure yet</option>
          </select>
        </label>
      </div>
      <label>What are you looking for?<textarea name="contact[body]" rows="4" placeholder="Your favourite pieces, fit questions, or anything you want us to know."></textarea></label>
      <label class="signup-form__consent"><input type="checkbox" name="contact[marketing_consent]" value="Yes" required><span>I agree to receive launch updates and early-access information from THELIVINGSTOP. I can unsubscribe at any time.</span></label>
      <button class="tls-button tls-button--primary" type="submit">Join early access</button>
      <p class="signup-form__fineprint">We only use these details to respond to your request and send the updates you choose. Checkout collects your final delivery and payment information.</p>
    {% endform %}
  </div>
</section>
{% schema %}
{"name":"Signup form","presets":[{"name":"Signup form"}]}
{% endschema %}
