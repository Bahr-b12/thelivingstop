{% assign clean_heading = section.settings.heading | remove: '**' %}
<section class="featured-collections section-pad">
  <div class="section-heading section-heading--split">
    <div><p class="eyebrow">Shop by category</p><h2>{{ clean_heading }}</h2></div>
    {% render 'button', label: 'View all', href: routes.all_products_collection_url, style: 'secondary' %}
  </div>
  <div class="category-grid">
    {% for block in section.blocks %}
      <a class="category-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        <img src="{{ block.settings.asset_name | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        <span>{{ block.settings.title | remove: '**' }}</span>
        <small>{{ block.settings.note | remove: '**' }}</small>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Featured collections","settings":[{"type":"text","id":"heading","label":"Heading","default":"Streetwear, simplified."}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"text","id":"title","label":"Title","default":"T-Shirts"},{"type":"text","id":"note","label":"Fit note","default":"Heavy cotton. Everyday motion."},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"asset_name","label":"Asset filename","default":"white-tee-male-1.jpg"}]}],"presets":[{"name":"Featured collections","blocks":[{"type":"collection","settings":{"title":"T-Shirts","asset_name":"white-tee-male-1.jpg"}},{"type":"collection","settings":{"title":"Hoodies","asset_name":"product-concrete-1.jpg","note":"Weight and warmth."}},{"type":"collection","settings":{"title":"Denim","asset_name":"product-concrete-3.jpg","note":"Built to last."}},{"type":"collection","settings":{"title":"Polos","asset_name":"black-polo-1.jpg"}},{"type":"collection","settings":{"title":"Matching Outfits","asset_name":"matching-outfits-1.jpg","note":"Made to share."}}]}]}
{% endschema %}
