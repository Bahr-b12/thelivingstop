<section class="not-found section-pad">
  <div>
    {% render 'red-circle' %}
    <p class="eyebrow">404</p>
    <h1>Page not found.</h1>
    <p>Try the collection instead.</p>
    <div class="hero__actions">
      {% render 'button', label: 'Shop products', href: '/pages/products', style: 'primary' %}
      {% render 'button', label: 'Go home', href: routes.root_url, style: 'secondary' %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Main 404"}
{% endschema %}
