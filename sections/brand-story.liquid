<section class="brand-story section-pad">
  <div class="brand-story__intro">
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.copy }}</p>
  </div>
  <div class="brand-story__tiles">
    {% for block in section.blocks %}
      <article {{ block.shopify_attributes }}>
        {% render 'red-circle' %}
        <h2>{{ block.settings.title }}</h2>
        <p>{{ block.settings.copy }}</p>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Brand story","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Life. Period."},{"type":"text","id":"heading","label":"Heading","default":"Conscious pieces for real life."},{"type":"textarea","id":"copy","label":"Copy","default":"Quality streetwear, made with care."}],"blocks":[{"type":"tile","name":"Story tile","settings":[{"type":"text","id":"title","label":"Title","default":"THE LIVING"},{"type":"textarea","id":"copy","label":"Copy","default":"Move. Connect. Live."}]}],"presets":[{"name":"Brand story","blocks":[{"type":"tile","settings":{"title":"THE LIVING","copy":"Move. Connect. Live."}},{"type":"tile","settings":{"title":"THE STOP","copy":"A stop to fast fashion and child labor."}},{"type":"tile","settings":{"title":"TOGETHER","copy":"Kindness without the guilt."}},{"type":"tile","settings":{"title":"ALIVE AND IN","copy":"Clothes for everyday movement."}}]}]}
{% endschema %}
