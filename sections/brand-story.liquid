<section class="brand-story section-pad">
  <div class="brand-story__intro">
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.copy }}</p>
  </div>
  <div class="brand-story__tiles">
    {% for block in section.blocks %}
      <article {{ block.shopify_attributes }}>
        {% render 'red-circle' %}
        <h2>{{ block.settings.title }}</h2>
        <p>{{ block.settings.copy }}</p>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Brand story","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Life. Period."},{"type":"text","id":"heading","label":"Heading","default":"Where fast fashion ends, and conscious living begins."},{"type":"textarea","id":"copy","label":"Copy","default":"THELIVINGSTOP is a premium streetwear brand built around a simple pause: choose kindness, choose quality, choose pieces made for real life."}],"blocks":[{"type":"tile","name":"Story tile","settings":[{"type":"text","id":"title","label":"Title","default":"THE LIVING"},{"type":"textarea","id":"copy","label":"Copy","default":"Life, movement, vibrancy, community, and being alive."}]}],"presets":[{"name":"Brand story","blocks":[{"type":"tile","settings":{"title":"THE LIVING","copy":"Life, movement, vibrancy, community, and being alive."}},{"type":"tile","settings":{"title":"THE STOP","copy":"The red circle is a hard stop on child labor, poor quality, fast fashion, and ignoring vulnerable beings."}},{"type":"tile","settings":{"title":"TOGETHER","copy":"Choosing kindness, quality, and conscious living without turning fashion into guilt."}},{"type":"tile","settings":{"title":"ALIVE AND IN","copy":"Clothing for movement, community, and everyday living."}}]}]}
{% endschema %}
