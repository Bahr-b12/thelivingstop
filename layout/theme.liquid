<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.brand_black }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {{ content_for_header }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --tls-red: {{ settings.brand_red | default: '#BF0404' }};
        --tls-black: {{ settings.brand_black | default: '#050505' }};
        --tls-white: {{ settings.brand_white | default: '#FAFAF7' }};
      }
    </style>
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.themeRoutes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_url: '{{ routes.cart_url }}',
        cart_section_url: '{{ routes.cart_url }}?sections=cart-drawer',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
    </script>
  </head>
  <body class="template-{{ request.page_type | handle }}">
    <div class="page-loader" data-page-loader aria-hidden="true">
      <div class="page-loader__brand">THELIVINGSTOP<span class="red-circle"></span></div>
      <div class="page-loader__track"><span></span></div>
    </div>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% section 'cart-drawer' %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
